/frontend-angular/tmp
/frontend-angular/out-tsc
/frontend-angular/bazel-out

# Node
/frontend-angular/node_modules
npm-debug.log
yarn-error.log

# Angular cache
/frontend-angular/.angular/cache
.sass-cache/

# Coverage
/frontend-angular/coverage

# Miscellaneous
