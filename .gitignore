/frontend-angular/libpeerconnection.log
/frontend-angular/testem.log
/frontend-angular/typings
/frontend-angular/__screenshots__/

# ═══════════════════════════════════════════
# .NET / C#
# ═══════════════════════════════════════════

# Build output
/backend/**/bin/
/backend/**/obj/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio
.vs/
*.userprefs

# NuGet
/backend/**/packages/
/backend/**/*.nupkg
/backend/**/*.snupkg
/backend/**/project.lock.json
/backend/**/project.fragment.lock.json
/backend/**/artifacts/

# EF Core Migrations (keep the folder, ignore nothing — migrations should be committed)
# Do NOT ignore Migrations/ — EF generated files should be tracked

# Secrets — NEVER commit these
/backend/**/appsettings.Development.json
/backend/**/appsettings.Production.json
**/secrets.json

